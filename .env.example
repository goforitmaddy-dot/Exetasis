# ==============================================================================
# Exetasis Environment Configuration Template
# Copy this file to .env and adjust variables as appropriate for your environment.
# ==============================================================================

# Application Configuration
APP_NAME=Exetasis
APP_ENV=development
DEBUG=true
PORT=8000
HOST=0.0.0.0

# CORS Configuration (comma-separated origins)
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Database Configuration (SQLite async connection string)
DATABASE_URL=sqlite+aiosqlite:///./exetasis.db

# LLM Provider Configuration
# Supported options: 'ollama' (default local), 'vllm' (local or AMD-hosted), 'mock'
# Rule: ONLY open-source/open-weight models served locally. No OpenAI/Anthropic SDKs.
LLM_PROVIDER=ollama

# Ollama Settings (default local runner)
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3.2:latest

# vLLM Settings (local or remote AMD-hosted vLLM instance)
VLLM_BASE_URL=http://localhost:8000/v1
VLLM_MODEL=meta-llama/Llama-3.2-3B-Instruct

# Optional Gemini Settings (Strictly disabled by default, optional fallback only)
GEMINI_ENABLED=false
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-1.5-flash

# WebSocket Configuration
WS_HEARTBEAT_INTERVAL_SECONDS=15
